#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Two modes:
#  - Home Assistant App (Supervisor sets SUPERVISOR_TOKEN): options come from bashio::config.
# (bashio::log is avoided: bashio reads LOG_LEVEL itself and fails on values like "debug".)
#  - Plain `docker run`: standalone mode, settings from env (PORT, IDLE_UNLOAD_MINUTES, MAX_SIDE,
#    LOG_LEVEL, LOCAL_OCR_TOKEN).
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    echo "Starting Local OCR (Home Assistant App) on port 8738"
    exec python -m local_ocr_server \
        --port 8738 \
        --token-file /data/token \
        --idle-unload-minutes "$(bashio::config 'idle_unload_minutes')" \
        --max-side "$(bashio::config 'max_side')" \
        --log-level "$(bashio::config 'log_level')"
fi

echo "Starting Local OCR (standalone) on port ${PORT:-8738}"
exec python -m local_ocr_server --standalone \
    --port "${PORT:-8738}" \
    --idle-unload-minutes "${IDLE_UNLOAD_MINUTES:-10}" \
    --max-side "${MAX_SIDE:-2000}" \
    --log-level "${LOG_LEVEL:-info}"
